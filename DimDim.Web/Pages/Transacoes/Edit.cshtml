@page
@model DimDim.Web.Pages.Transacoes.EditModel

@{
    ViewData["Title"] = "Editar transação";
}

<h1>Editar transação</h1>

<form method="post" class="mt-4">

    <input type="hidden"
           asp-for="Transacao.Id" />

    <div asp-validation-summary="ModelOnly"
         class="text-danger mb-3">
    </div>

    <div class="mb-3">
        <label asp-for="Transacao.Descricao"
               class="form-label">
            Descrição
        </label>

        <input asp-for="Transacao.Descricao"
               class="form-control" />
    </div>

    <div class="mb-3">
        <label asp-for="Transacao.Valor"
               class="form-label">
            Valor
        </label>

        <input asp-for="Transacao.Valor"
               type="number"
               step="0.01"
               class="form-control" />
    </div>

    <div class="mb-3">
        <label asp-for="Transacao.Tipo"
               class="form-label">
            Tipo
        </label>

        <select asp-for="Transacao.Tipo"
                class="form-select">

            <option value="Receita">Receita</option>
            <option value="Despesa">Despesa</option>

        </select>
    </div>

    <div class="mb-3">
        <label asp-for="Transacao.Data"
               class="form-label">
            Data
        </label>

        <input asp-for="Transacao.Data"
               type="datetime-local"
               class="form-control" />
    </div>

    <div class="mb-3">
        <label asp-for="Transacao.ClienteId"
               class="form-label">
            Cliente
        </label>

        <select asp-for="Transacao.ClienteId"
                asp-items="Model.Clientes"
                class="form-select">
        </select>
    </div>

    <button type="submit"
            class="btn btn-primary">
        Salvar alterações
    </button>

    <a asp-page="Index"
       class="btn btn-secondary">
        Cancelar
    </a>

</form>