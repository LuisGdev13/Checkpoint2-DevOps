@page
@model DimDim.Web.Pages.Transacoes.CreateModel

@{
    ViewData["Title"] = "Nova transação";
}

<h1>Nova transação</h1>

<form method="post" class="mt-4">

    <div asp-validation-summary="ModelOnly"
         class="text-danger mb-3">
    </div>

    <div class="mb-3">
        <label asp-for="Transacao.Descricao"
               class="form-label">
            Descrição
        </label>

        <input asp-for="Transacao.Descricao"
               class="form-control" />

        <span asp-validation-for="Transacao.Descricao"
              class="text-danger">
        </span>
    </div>

    <div class="mb-3">
        <label asp-for="Transacao.Valor"
               class="form-label">
            Valor
        </label>

        <input asp-for="Transacao.Valor"
               type="number"
               step="0.01"
               min="0"
               class="form-control" />

        <span asp-validation-for="Transacao.Valor"
              class="text-danger">
        </span>
    </div>

    <div class="mb-3">
        <label asp-for="Transacao.Tipo"
               class="form-label">
            Tipo
        </label>

        <select asp-for="Transacao.Tipo"
                class="form-select">

            <option value="">Selecione...</option>
            <option value="Receita">Receita</option>
            <option value="Despesa">Despesa</option>

        </select>

        <span asp-validation-for="Transacao.Tipo"
              class="text-danger">
        </span>
    </div>

    <div class="mb-3">
        <label asp-for="Transacao.Data"
               class="form-label">
            Data
        </label>

        <input asp-for="Transacao.Data"
               type="datetime-local"
               class="form-control" />

        <span asp-validation-for="Transacao.Data"
              class="text-danger">
        </span>
    </div>

    <div class="mb-3">
        <label asp-for="Transacao.ClienteId"
               class="form-label">
            Cliente
        </label>

        <select asp-for="Transacao.ClienteId"
                asp-items="Model.Clientes"
                class="form-select">

            <option value="">Selecione um cliente...</option>

        </select>

        <span asp-validation-for="Transacao.ClienteId"
              class="text-danger">
        </span>
    </div>

    <button type="submit"
            class="btn btn-primary">
        Salvar
    </button>

    <a asp-page="Index"
       class="btn btn-secondary">
        Cancelar
    </a>

</form>